{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:{sqlserver}.database.windows.net,1433;Database=eShopModernized;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "Redis": "{redis}.redis.cache.windows.net:6380,password={redisKey},ssl=True,abortConnect=False"
  },
  "ApplicationInsights": {
    "InstrumentationKey": "#{AI_INSTRUMENTATION_KEY}#"
  },
  "Azure": {
    "Storage": {
      "AccountName": "#{STORAGE_ACCOUNT_NAME}#",
      "ContainerName": "catalog-images"
    },
    "KeyVault": {
      "VaultUri": "https://#{KEY_VAULT_NAME}#.vault.azure.net/"
    }
  },
  "CatalogSettings": {
    "UseMockData": false,
    "UseCustomizationData": false,
    "PictureBaseUrl": "https://#{STORAGE_ACCOUNT_NAME}#.blob.core.windows.net/catalog-images/"
  }
}